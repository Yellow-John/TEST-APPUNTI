# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Facoltativa: serve solo per mostrare le immagini nelle note condivise via link. NON esporla mai al browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=sk-ant-...
# Modello (facoltativo). Predefinito: claude-opus-5-5. Alternative più economiche: claude-sonnet-5-5, claude-haiku-5-5
ANTHROPIC_MODEL=

# --- Sicurezza ---
# La tua email: solo questo account potrà usare le funzioni AI (protegge la tua chiave API).
ALLOWED_EMAIL=
