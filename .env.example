# --- Supabase, piano gratuito (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Chiave pubblica: "Publishable key" (sb_publishable_...). In alternativa puoi usare NEXT_PUBLIC_SUPABASE_ANON_KEY (legacy, eyJ...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Facoltativa: serve solo per mostrare le immagini nelle note condivise via link. NON esporla mai al browser.
# "Secret key" (sb_secret_...) oppure la legacy SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# --- Google Gemini, piano gratuito (aistudio.google.com → Get API key) ---
# Crea la chiave SENZA attivare la fatturazione: così non può mai esserci alcun addebito.
GEMINI_API_KEY=
# Facoltativi: modelli da usare (predefiniti: gemini-flash-latest e gemini-flash-lite-latest)
GEMINI_MODEL=
GEMINI_MODEL_LITE=

# --- Sicurezza ---
# La tua email: solo questo account potrà usare le funzioni AI (protegge la tua quota).
ALLOWED_EMAIL=

# --- Altri provider AI gratuiti (facoltativi) ---
# Usati quando i modelli Gemini sono esauriti o occupati. Basta la chiave: i modelli gratuiti vengono scelti in automatico.
# Mistral (console.mistral.ai → piano "Experiment" gratuito)
MISTRAL_API_KEY=
# Groq (console.groq.com → API Keys)
GROQ_API_KEY=
# OpenRouter (openrouter.ai → Keys): usati solo i modelli ":free"
OPENROUTER_API_KEY=
# Cerebras (cloud.cerebras.ai → API Keys): solo testo, niente foto
CEREBRAS_API_KEY=

# FreeLLMAPI (facoltativo): proxy self-hosted, serve un server sempre acceso
# FREELLMAPI_URL=https://il-tuo-server.example.com/v1
# FREELLMAPI_KEY=freellmapi-...
# FREELLMAPI_MODE=fallback   # oppure "first" per usarlo prima di Gemini
