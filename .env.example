# --- Supabase, piano gratuito (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Facoltativa: serve solo per mostrare le immagini nelle note condivise via link. NON esporla mai al browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini, piano gratuito (aistudio.google.com → Get API key) ---
# Crea la chiave SENZA attivare la fatturazione: così non può mai esserci alcun addebito.
GEMINI_API_KEY=
# Facoltativi: modelli da usare (predefiniti: gemini-flash-latest e gemini-flash-lite-latest)
GEMINI_MODEL=
GEMINI_MODEL_LITE=

# --- Sicurezza ---
# La tua email: solo questo account potrà usare le funzioni AI (protegge la tua quota).
ALLOWED_EMAIL=
